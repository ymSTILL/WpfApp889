<Window x:Class="WpfApp8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF飲料訂購ver2" Height="520" Width="720"
        Background="#FFFFFF">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 用餐方式區 -->
        <GroupBox Header="內用/外帶" Grid.Column="0" Grid.Row="0" 
                  Background="#FFD6C9B5" BorderBrush="#E5C3A6" Margin="0,0,0,10" Padding="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton x:Name="rbIn" Content="內用" IsChecked="True" FontSize="14" Margin="0,0,50,0"/>
                <RadioButton x:Name="rbOut" Content="外帶" FontSize="14"/>
            </StackPanel>
        </GroupBox>

        <!-- 飲料品項區 -->
        <Border Grid.Column="0" Grid.Row="1" Background="#FF98A980" Padding="2">
            <StackPanel>
                <!-- 品項 1：紅茶大杯 -->
                <Border Background="#FFBDE694" Margin="0,1" Padding="10,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chk1" Content="紅茶大杯" Foreground="#333399" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="60元" Grid.Column="1" Foreground="#A83232" FontSize="14" VerticalAlignment="Center"/>
                        <Slider x:Name="sld1" Grid.Column="2" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBlock Text="{Binding ElementName=sld1, Path=Value, StringFormat='{}{0:F0}'}" Grid.Column="3" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 品項 2：紅茶小杯 -->
                <Border Background="#FFB7DC92" Margin="0,1" Padding="10,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chk2" Content="紅茶小杯" Foreground="#333399" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="40元" Grid.Column="1" Foreground="#A83232" FontSize="14" VerticalAlignment="Center"/>
                        <Slider x:Name="sld2" Grid.Column="2" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBlock Text="{Binding ElementName=sld2, Path=Value, StringFormat='{}{0:F0}'}" Grid.Column="3" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 品項 3：綠茶大杯 -->
                <Border Background="#FFC8E6AA" Margin="0,1" Padding="10,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chk3" Content="綠茶大杯" Foreground="#333399" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="60元" Grid.Column="1" Foreground="#A83232" FontSize="14" VerticalAlignment="Center"/>
                        <Slider x:Name="sld3" Grid.Column="2" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBlock Text="{Binding ElementName=sld3, Path=Value, StringFormat='{}{0:F0}'}" Grid.Column="3" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 品項 4：綠茶小杯 -->
                <Border Background="#FFC2F78E" Margin="0,1" Padding="10,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chk4" Content="綠茶小杯" Foreground="#333399" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="40元" Grid.Column="1" Foreground="#A83232" FontSize="14" VerticalAlignment="Center"/>
                        <Slider x:Name="sld4" Grid.Column="2" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBlock Text="{Binding ElementName=sld4, Path=Value, StringFormat='{}{0:F0}'}" Grid.Column="3" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 品項 5：可樂大杯 -->
                <Border Background="#FFA7E26D" Margin="0,1" Padding="10,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chk5" Content="可樂大杯" Foreground="#333399" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="50元" Grid.Column="1" Foreground="#A83232" FontSize="14" VerticalAlignment="Center"/>
                        <Slider x:Name="sld5" Grid.Column="2" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBlock Text="{Binding ElementName=sld5, Path=Value, StringFormat='{}{0:F0}'}" Grid.Column="3" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 品項 6：可樂小杯 -->
                <Border Background="#FF97CC61" Margin="0,1" Padding="10,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chk6" Content="可樂小杯" Foreground="#333399" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="30元" Grid.Column="1" Foreground="#A83232" FontSize="14" VerticalAlignment="Center"/>
                        <Slider x:Name="sld6" Grid.Column="2" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBlock Text="{Binding ElementName=sld6, Path=Value, StringFormat='{}{0:F0}'}" Grid.Column="3" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- 明細輸出區 -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" 
                Background="#FF9DD8A8" Margin="0,10,0,0" Padding="12" CornerRadius="5">
            <TextBlock x:Name="txtOrderSummary" Text="請選購飲料並點擊「訂購」按鈕..." FontSize="14" Foreground="#333333" TextWrapping="Wrap"/>
        </Border>

        <!-- 按鈕 -->
        <Button Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Content="訂購" 
                Width="100" Height="50" FontSize="15" 
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Click="btnOrder_Click" Background="#FFE6C5C5"/>
    </Grid>
</Window>